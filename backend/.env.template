# CHEAT CLIP — Environment Template
# ============================================================
# This app does NOT use a server-side Gemini API key.
# Users provide their own Gemini API key via the web interface at runtime.
#
# Get a free key at: https://aistudio.google.com/
# ============================================================

# Rotating Supadata API Keys for serverless YouTube transcript auto-fetching.
# Provide one or more comma-separated keys. The backend automatically rotates
# through them to distribute requests and handle rate limits/quota exhaustion.
# Get free keys (100 req/month each) at: https://supadata.ai/
SUPADATA_API_KEYS=key1,key2,key3

# Proxy Configuration for fallback subtitle fetching & datacenter scraping.
# Used when Supadata API fails, when quotas are exhausted, or when hosting on cloud/VPS providers
# where YouTube blocks datacenter IPs (RequestBlocked / IpBlocked).
# Reference: https://github.com/jdepoix/youtube-transcript-api#working-around-ip-bans-requestblocked-or-ipblocked-exception

# OPTION 1: Webshare Rotating Residential Proxy Credentials (Recommended by youtube-transcript-api)
# Get "Proxy Username" and "Proxy Password" from: https://dashboard.webshare.io/proxy/settings
# Note: Use "Residential" package (not static datacenter).
# WEBSHARE_USERNAME=your_webshare_username
# WEBSHARE_PASSWORD=your_webshare_password
# WEBSHARE_LOCATIONS=us,de    # Optional: comma-separated country codes to minimize latency
# WEBSHARE_RETRIES=5          # Optional: retries when encountering a blocked IP (default: 5)

# OPTION 2: Webshare Rotating Proxy URL (Single or Comma-Separated List)
# Supports a single proxy or a comma-separated list of multiple proxy endpoints for automatic round-robin rotation.
# WEBSHARE_PROXY=http://your_username-rotate:your_password@p.webshare.io:80
# Multi-account example:
# WEBSHARE_PROXY=http://user1-rotate:pass1@p.webshare.io:80,http://user2-rotate:pass2@p.webshare.io:80

# OPTION 3: Generic HTTP/HTTPS/SOCKS5 Proxy URLs (Single or Comma-Separated List)
# PROXY_URL=http://user:pass@proxy1:port,http://user:pass@proxy2:port
# HTTP_PROXY=http://username:password@proxy-host:port
# HTTPS_PROXY=http://username:password@proxy-host:port

